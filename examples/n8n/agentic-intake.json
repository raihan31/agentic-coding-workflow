        "options": {}
      }
    },
    {
      "id": "i3",
      "name": "Project created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"id\": $json.id } }}",
        "options": {
          "responseCode": 201
        }
      }
    }
  ],
  "connections": {
