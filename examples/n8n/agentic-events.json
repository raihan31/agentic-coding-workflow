    {
      "id": "n2",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Verifies the orchestrator's HMAC signature (x-agentic-signature over \"<timestamp>.<body>\") and classifies the event.\nconst crypto = require('crypto');\nconst secret = $env.AGENTIC_WEBHOOK_SECRET;\nreturn $input.all().map(item => {\n  const headers = item.json.headers ?? {};\n  const body = item.json.body ?? {};\n  const timestamp = String(headers['x-agentic-timestamp'] ?? '');\n  const given = String(headers['x-agentic-signature'] ?? '');\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret ?? '').update(`${timestamp}.${JSON.stringify(body)}`).digest('hex');\n  const fresh = /^\\d+$/.test(timestamp) && Math.abs(Date.now() / 1000 - Number(timestamp)) < 300;\n  const valid = Boolean(secret) && fresh && given.length === expected.length && crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected));\n  const status = body.data?.status;\n  const needsHuman = body.type === 'task.escalated' || (body.type === 'project.status' && ['needs_answers', 'needs_attention', 'backlog_ready'].includes(status));\n  const what = body.type === 'task.escalated' ? `${body.taskId} needs your input: ${body.data?.question}`\n    : body.type === 'project.status' ? `Project is ${String(status).replace(/_/g, ' ')}${body.data?.error ? `: ${body.data.error}` : ''}`\n    : body.type === 'manager.decision' ? `${body.taskId}: manager decided to ${body.data?.decision}: ${body.data?.rationale}`\n    : body.type;\n  return { json: { valid, needsHuman, type: body.type, projectId: body.projectId, taskId: body.taskId ?? null, status: status ?? null,\n    message: `[${body.projectId}] ${what}`, link: body.links?.project ?? null } };\n});"
      }
    },
    {
      "id": "n3",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "n3-c",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
