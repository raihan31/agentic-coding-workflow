{
  "name": "agentic-claude-codex-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test",
    "sandbox:build": "docker build -t agentic-agent:local -f deploy/agent.Dockerfile deploy",
    "stack:up": "docker compose -f deploy/compose.yaml up -d --wait",
    "stack:down": "docker compose -f deploy/compose.yaml --profile gateway --profile n8n down",
    "stack:up:gateway": "docker compose -f deploy/compose.yaml --profile gateway up -d --wait",
    "stack:up:n8n": "docker compose -f deploy/compose.yaml --profile n8n up -d --wait",
    "worker": "tsx src/cli.ts worker",
    "eval": "npx -y promptfoo@0.123.1 eval -c evals/promptfooconfig.yaml",
    "eval:view": "npx -y promptfoo@0.123.1 view",
    "api": "tsx src/cli.ts api",
    "ui:dev": "vite --config web/vite.config.ts",
    "ui:build": "vite build --config web/vite.config.ts",
    "desktop": "npm run ui:build && electron desktop/main.cjs",
    "desktop:dev": "electron desktop/main.cjs --dev"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "eslint": "^9.39.5",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "openai": "^7.43.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  }
}
